{
  "name": "@obniz/obniz-now-sdk",
  "version": "0.1.3",
  "description": "TypeScript/JavaScript SDK for obniz Now API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "openapi-generator-cli generate",
    "build": "rm -rf dist && rollup -c",
    "dev": "rollup -c --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "author": "obniz",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obniz/obniz-now-sdk-js.git"
  },
  "keywords": [
    "obniz"
  ],
  "homepage": "https://obniz.com/",
  "private": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.28.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "rollup": "^4.41.1",
    "tslib": "^2.8.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
